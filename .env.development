# Local development runs entirely in the browser: in-memory fixtures, simulated latency and
# simulated live events, with a dev user whose active role is switched from the user menu.
VITE_API_BASE=http://localhost:5100
VITE_USE_MOCKS=true
VITE_AUTH_DISABLED=true
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/fusion
VITE_OIDC_CLIENT_ID=fusion-web
