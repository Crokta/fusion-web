# Gateway origin. The UI calls ${VITE_API_BASE}/api/v1/... and the SignalR hub at /hubs/live.
VITE_API_BASE=http://localhost:5100
# true: in-memory mock adapter and simulated realtime events (no backend needed).
VITE_USE_MOCKS=false
# true: skip Keycloak and sign in as a local dev user with a role switcher.
VITE_AUTH_DISABLED=false
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/fusion
VITE_OIDC_CLIENT_ID=fusion-web
